<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="1200" height="675">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0a0a"/>
      <stop offset="100%" stop-color="#141414"/>
    </linearGradient>
    <radialGradient id="glow" cx="80%" cy="30%" r="60%">
      <stop offset="0%" stop-color="#d4ff00" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#d4ff00" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)"/>
  <rect width="1200" height="675" fill="url(#grid)"/>
  <circle cx="960" cy="200" r="350" fill="url(#glow)"/>
  <line x1="80" y1="80" x2="1120" y2="80" stroke="rgba(212,255,0,0.4)" stroke-width="2"/>
  <text x="80" y="60" fill="#d4ff00" font-family="'Courier New', monospace" font-size="14" letter-spacing="4">01 // CREATIVE WORK — YOUTUBE THUMBNAIL DESIGN</text>
  <text x="80" y="240" fill="#ffffff" font-family="sans-serif" font-weight="900" font-size="84" letter-spacing="-2">BUILDING</text>
  <text x="80" y="330" fill="#d4ff00" font-family="sans-serif" font-weight="900" font-size="96" letter-spacing="-2">DATA PIPELINES</text>
  <text x="80" y="420" fill="rgba(255,255,255,0.7)" font-family="sans-serif" font-weight="700" font-size="64">IN PYTHON &amp; SQL</text>
  <rect x="80" y="480" width="220" height="50" rx="25" fill="#d4ff00"/>
  <text x="190" y="512" fill="#0a0a0a" font-family="sans-serif" font-weight="800" font-size="16" text-anchor="middle" letter-spacing="2">WATCH NOW ➔</text>
  <circle cx="920" cy="380" r="140" fill="none" stroke="#d4ff00" stroke-width="3" stroke-dasharray="10 15"/>
  <text x="920" y="390" fill="#ffffff" font-family="sans-serif" font-weight="900" font-size="32" text-anchor="middle">FULL GUIDE</text>
  <line x1="80" y1="600" x2="1120" y2="600" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
  <text x="80" y="630" fill="rgba(255,255,255,0.4)" font-family="sans-serif" font-size="14">DEBJEET DEY DESIGN STUDIO • FREELANCE WORK 2026</text>
</svg>
